@model IEnumerable<PhoneShop.Models.Orders>
@using PhoneShop.Models
@{ ViewData["Title"] = "Order Management"; }

<section class="content-header">
    <div class="container-fluid"><h1>Order Management</h1></div>
</section>
<section class="content">
    <div class="card">
        <div class="card-body table-responsive p-0">
            <table class="table table-hover">
                <thead>
                    <tr><th>Order</th><th>Date</th><th>Customer</th><th>Total</th><th>Payment</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td>#@order.Id</td>
                        <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@order.CustomerName<br><small>@order.ShippingPhone</small></td>
                        <td>$@order.TotalAmount.ToString("F2")</td>
                        <td>@order.PaymentMethod - @order.PaymentStatus</td>
                        <td>@((OrderStatus)order.Status)</td>
                        <td><a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-info">Details</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</section>
