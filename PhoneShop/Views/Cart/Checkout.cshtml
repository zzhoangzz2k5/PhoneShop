@model PhoneShop.Models.CheckoutViewModel

<!-- xc-breadcrumb area start -->
<div class="xc-breadcrumb__area base-bg">
    <div class="xc-breadcrumb__bg w-img xc-breadcrumb__overlay"></div>
    <div class="container">
        <div class="row">
            <div class="col-xxl-12">
                <div class="xc-breadcrumb__content p-relative z-index-1">
                    <div class="xc-breadcrumb__list">
                        <span><a asp-controller="Home" asp-action="Index">Home</a></span>
                        <span class="dvdr"><i class="icon-arrow-right"></i></span>
                        <span>Checkout</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- xc-breadcrumb area end -->

<!-- checkout-area start -->
<section class="checkout-area pt-80 pb-85">
    <div class="container">
        <form method="post" asp-controller="Cart" asp-action="CreatePayPalOrder" id="checkout-form" onsubmit="return false;">
            <div class="row">
                <div class="col-lg-8">
                    <div class="checkbox-form">
                        <h3 class="mb-30">Billing Details</h3>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="checkout-form-list mb-3">
                                    <label class="form-label">First Name <span class="text-danger">*</span></label>
                                    <input type="text" name="firstName" class="form-control" placeholder="First Name" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="checkout-form-list mb-3">
                                    <label class="form-label">Last Name <span class="text-danger">*</span></label>
                                    <input type="text" name="lastName" class="form-control" placeholder="Last Name" required>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="checkout-form-list mb-3">
                                    <label class="form-label">Address <span class="text-danger">*</span></label>
                                    <input type="text" name="address" class="form-control" placeholder="Street address" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="checkout-form-list mb-3">
                                    <label class="form-label">Email Address <span class="text-danger">*</span></label>
                                    <input type="email" name="email" class="form-control" placeholder="Your Email" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="checkout-form-list mb-3">
                                    <label class="form-label">Phone <span class="text-danger">*</span></label>
                                    <input type="text" name="phone" class="form-control" placeholder="Phone number" required>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="checkout-form-list mb-3">
                                    <label class="form-label">Order Notes</label>
                                    <textarea name="message" class="form-control" placeholder="Notes about your order, e.g. special notes for delivery."></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="shop_cart_widget xc-accordion">
                        <div class="accordion" id="shop_size">
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="size__widget">
                                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#size_widget_collapse" aria-expanded="true" aria-controls="size_widget_collapse">
                                        Your Order Summary
                                    </button>
                                </h2>
                                <div id="size_widget_collapse" class="accordion-collapse collapse show" aria-labelledby="size__widget" data-bs-parent="#shop_size">
                                    <div class="accordion-body">
                                        <div class="cart-subtitle">
                                            <h4>Subtotal</h4>
                                            <h4>@Model.Currency @(Model.CartItems.Sum(i => i.SubTotal).ToString("F2"))</h4>
                                        </div>
                                        <div class="cart-checkout">
                                            <h4>Items</h4>
                                            <ul class="list-unstyled">
                                                @foreach (var item in Model.CartItems)
                                                {
                                                    <li class="d-flex justify-content-between py-1" style="font-size: 14px;">
                                                        <span class="text-muted">@item.Name x @item.Quantity</span>
                                                        <span>@Model.Currency @item.SubTotal.ToString("F2")</span>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                        <div class="cart-checkout">
                                            <h4>Payment Method</h4>
                                            <p class="small text-muted mb-2">Pay securely with PayPal.</p>
                                        </div>
                                        <div class="cart-totails">
                                            <h4>Total</h4>
                                            <h4>@Model.Currency @(Model.CartItems.Sum(i => i.SubTotal).ToString("F2"))</h4>
                                        </div>
                                        <p class="small text-muted mb-3">Complete your billing details, then approve the payment in PayPal.</p>
                                        <div id="paypal-message" class="alert d-none" role="alert"></div>
                                        @if (Model.IsPayPalConfigured)
                                        {
                                            <div id="paypal-button-container"></div>
                                        }
                                        else
                                        {
                                            <div class="alert alert-warning mb-0">
                                                PayPal is not configured. Add the sandbox Client ID and Client Secret to User Secrets.
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</section>
<!-- checkout-area end -->

@if (Model.IsPayPalConfigured)
{
    var paypalSdkUrl = $"https://www.paypal.com/sdk/js?client-id={Uri.EscapeDataString(Model.PayPalClientId)}&currency={Uri.EscapeDataString(Model.Currency)}&components=buttons";

    @section Scripts {
        <script src="@paypalSdkUrl"></script>
        <script>
            (() => {
                const form = document.getElementById('checkout-form');
                const message = document.getElementById('paypal-message');
                let checkoutToken = '';

                const showMessage = (text, type = 'danger') => {
                    message.textContent = text;
                    message.className = `alert alert-${type}`;
                };

                const readJson = async response => {
                    const result = await response.json().catch(() => ({}));
                    if (!response.ok) {
                        throw new Error(result.message || 'The payment request could not be completed.');
                    }
                    return result;
                };

                paypal.Buttons({
                    style: {
                        layout: 'vertical',
                        color: 'gold',
                        shape: 'rect',
                        label: 'paypal'
                    },
                    onClick(data, actions) {
                        message.className = 'alert d-none';
                        if (!form.checkValidity()) {
                            form.reportValidity();
                            return actions.reject();
                        }
                        return actions.resolve();
                    },
                    async createOrder() {
                        showMessage('Connecting to PayPal...', 'info');
                        const response = await fetch('@Url.Action("CreatePayPalOrder", "Cart")', {
                            method: 'POST',
                            body: new FormData(form)
                        });
                        const order = await readJson(response);
                        checkoutToken = order.checkoutToken;
                        message.className = 'alert d-none';
                        return order.id;
                    },
                    async onApprove(data) {
                        showMessage('Confirming your payment...', 'info');
                        const formData = new FormData(form);
                        formData.append('payPalOrderId', data.orderID);
                        formData.append('checkoutToken', checkoutToken);

                        const response = await fetch('@Url.Action("CapturePayPalOrder", "Cart")', {
                            method: 'POST',
                            body: formData
                        });
                        const result = await readJson(response);
                        window.location.assign(result.successUrl);
                    },
                    onCancel() {
                        showMessage('The PayPal payment was cancelled.', 'warning');
                    },
                    onError(error) {
                        console.error(error);
                        showMessage(error.message || 'PayPal could not complete the payment.');
                    }
                }).render('#paypal-button-container');
            })();
        </script>
    }
}
