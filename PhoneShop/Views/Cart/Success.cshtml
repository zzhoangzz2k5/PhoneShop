@{
    ViewData["Title"] = "Order completed";
}

<section class="pt-80 pb-80">
    <div class="container">
        <div class="mx-auto text-center" style="max-width: 720px;">
            <h1>Thank you for your order</h1>
            <p class="mt-3">Your order has been received and the cart has been cleared.</p>

            <div class="card mt-4 text-start">
                <div class="card-body">
                    <p><strong>Customer:</strong> @ViewBag.OrderName</p>
                    <p><strong>Phone:</strong> @ViewBag.OrderPhone</p>
                    <p><strong>Email:</strong> @ViewBag.OrderEmail</p>
                    <p><strong>Shipping address:</strong> @ViewBag.OrderAddress</p>
                    <p class="mb-0"><strong>Total:</strong> $@(((decimal)ViewBag.OrderTotal).ToString("F2"))</p>
                </div>
            </div>

            <a asp-controller="Home" asp-action="Index" class="swiftcart-btn mt-4">Continue Shopping</a>
        </div>
    </div>
</section>
