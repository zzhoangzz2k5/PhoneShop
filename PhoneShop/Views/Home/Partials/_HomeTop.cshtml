<div class="col-12 col-xl-9 col-xxl-10">
    <div class="xc-main-slider">
        <div class="xc-main-slider__carousel swiftcart-owl__carousel owl-carousel"
             data-owl-options='{
            "loop": true,
            "animateOut": "fadeOut",
            "animateIn": "fadeIn",
            "items": 1,
            "autoplay": true,
            "autoplayTimeout": 7000,
            "smartSpeed": 1000,
            "nav": false,
            "dots": false,
            "margin": 0
            }'>

            <div class="xc-main-slider__item item">
                <div class="xc-main-slider__left">
                    <div class="xc-main-slider__content">
                        <span class="xc-main-slider__subtitle">INTRODUCING NEW</span>
                        <h3 class="xc-main-slider__title">
                            Xiaomi Mi 11 Ultra <br />
                            12GB+256GB
                        </h3>
                        <p class="xc-main-slider__info">
                            *Data provided by internal laboratories.
                        </p>

                        <div class="xc-main-slider__btn">
                            <a class="swiftcart-btn"
                               asp-controller="Product"
                               asp-action="Details"
                               asp-route-id="5">
                                Shop now
                                <i class="icon-next"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <div class="xc-main-slider__right">
                    <div class="xc-main-slider__img">
                        <img src="~/img/slider/slider-1-1.png" alt="mobile">
                        <span class="xc-main-slider__price">$590</span>
                    </div>
                </div>
            </div>

            <div class="xc-main-slider__item item">
                <div class="xc-main-slider__left">
                    <div class="xc-main-slider__content">
                        <span class="xc-main-slider__subtitle">INTRODUCING NEW</span>
                        <h3 class="xc-main-slider__title">
                            iPhone 14 Pro Max <br />
                            256GB
                        </h3>

                        <p class="xc-main-slider__info">
                            Dynamic Island, A16 Bionic chip.
                        </p>

                        <div class="xc-main-slider__btn">
                            <a class="swiftcart-btn"
                               asp-controller="Product"
                               asp-action="Details"
                               asp-route-id="1">
                                Shop now
                                <i class="icon-next"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <div class="xc-main-slider__right">
                    <div class="xc-main-slider__img">
                        <img src="~/img/slider/slider-1-2.png" alt="mobile">
                        <span class="xc-main-slider__price">$999</span>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>