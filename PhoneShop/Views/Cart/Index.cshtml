@model List<PhoneShop.Models.CartItem>

<!-- xc-breadcrumb area start -->
<div class="xc-breadcrumb__area base-bg">
    <div class="xc-breadcrumb__bg w-img xc-breadcrumb__overlay"></div>
    <div class="container">
        <div class="row">
            <div class="col-xxl-12">
                <div class="xc-breadcrumb__content p-relative z-index-1">
                    <div class="xc-breadcrumb__list">
                        <span><a asp-controller="Home" asp-action="Index">Home</a></span>
                        <span class="dvdr"><i class="icon-arrow-right"></i></span>
                        <span>Shopping Cart</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- xc-breadcrumb area end -->

<div class="xc-cart-page pt-80 pb-80">
    <div class="container">
        @if (Model == null || Model.Count == 0)
        {
            <div class="text-center py-5">
                <h3>Your cart is empty</h3>
                <p class="mb-4">Looks like you haven't added any products to your cart yet.</p>
                <a asp-controller="Home" asp-action="Index" class="swiftcart-btn">Shop Now</a>
            </div>
        }
        else
        {
            <div class="row gutter-y-30 gx-5">
                <div class="col-lg-8 col-xl-9">
                    <div class="xc-cart-page__table">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th class="product-thumbnail">Images</th>
                                    <th class="cart-product-name">Product</th>
                                    <th class="product-price">Unit Price</th>
                                    <th class="product-quantity">Quantity</th>
                                    <th class="product-subtotal">Total</th>
                                    <th class="product-remove">Remove</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="product-thumbnail">
                                            <a asp-controller="Product" asp-action="Details" asp-route-id="@item.ProductId">
                                                <img src="~/img/products/@item.Photo" alt="@item.Name" style="max-height: 80px; object-fit: contain;">
                                            </a>
                                        </td>
                                        <td class="product-name">
                                            <a asp-controller="Product" asp-action="Details" asp-route-id="@item.ProductId">@item.Name</a>
                                        </td>
                                        <td class="product-price">
                                            <span class="amount">$@item.Price</span>
                                        </td>
                                        <td class="product-quantity">
                                            <div class="xc-product-quantity mt-10 mb-10">
                                                <span class="xc-cart-minus sub">
                                                    <i class="fas fa-minus"></i>
                                                </span>
                                                <input class="xc-cart-input cart-qty-input" type="text" data-product-id="@item.ProductId" value="@item.Quantity" readonly>
                                                <span class="xc-cart-plus add">
                                                    <i class="fas fa-plus"></i>
                                                </span>
                                            </div>
                                        </td>
                                        <td class="product-subtotal">
                                            <span class="amount" id="subtotal-@item.ProductId">$@(item.SubTotal.ToString("F2"))</span>
                                        </td>
                                        <td class="product-remove">
                                            <a asp-controller="Cart" asp-action="Remove" asp-route-id="@item.ProductId" class="text-danger"><i class="fa fa-times"></i></a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4 col-xl-3">
                    <div class="shop_cart_widget xc-accordion">
                        <div class="accordion" id="shop_size">
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="size__widget">
                                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#size_widget_collapse" aria-expanded="true" aria-controls="size_widget_collapse">
                                        Shopping Cart Summary
                                    </button>
                                </h2>
                                <div id="size_widget_collapse" class="accordion-collapse collapse show" aria-labelledby="size__widget" data-bs-parent="#shop_size">
                                    <div class="accordion-body">
                                        <div class="cart-subtitle">
                                            <h4>Subtotal</h4>
                                            <h4 class="cart-total-val">$@(Model.Sum(i => i.SubTotal).ToString("F2"))</h4>
                                        </div>
                                        <div class="cart-checkout">
                                            <h4>Shipping</h4>
                                            <div class="shop__widget-list">
                                                <div class="shop__widget-list-item-2">
                                                    <input type="radio" name="pay" id="c-rate" checked>
                                                    <label for="c-rate">Flat rate: $0.00</label>
                                                </div>
                                                <div class="shop__widget-list-item-2 has-orange">
                                                    <input type="radio" name="pay" id="c-Free">
                                                    <label for="c-Free">Free shipping</label>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="cart-totails">
                                            <h4>Total</h4>
                                            <h4 class="cart-total-val">$@(Model.Sum(i => i.SubTotal).ToString("F2"))</h4>
                                        </div>
                                        <p>Dynamic tax and shipping computed at checkout.</p>
                                        <a class="cart-checkout-btn text-center d-block mt-3" asp-controller="Cart" asp-action="Checkout">Proceed to Checkout</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Wait slightly for swiftcart.js to perform the visual input increment/decrement
            $(document).on('click', '.xc-product-quantity .add, .xc-product-quantity .sub', function () {
                var input = $(this).siblings('.cart-qty-input');
                var productId = input.data('product-id');
                
                // Get the updated value (swiftcart.js will update the input value on click)
                // We use setTimeout to let the DOM value update first
                setTimeout(function() {
                    var quantity = parseInt(input.val());
                    if (isNaN(quantity) || quantity < 1) {
                        quantity = 1;
                    }
                    
                    $.ajax({
                        url: '/Cart/UpdateQuantity',
                        type: 'POST',
                        data: { id: productId, quantity: quantity },
                        success: function (response) {
                            if (response.success) {
                                // Update item subtotal
                                $('#subtotal-' + productId).text('$' + response.itemSubtotal.toFixed(2));
                                // Update cart total
                                $('.cart-total-val').text('$' + response.subtotal.toFixed(2));
                            }
                        }
                    });
                }, 50);
            });
        });
    </script>
}
