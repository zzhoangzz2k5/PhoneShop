@model PhoneShop.Models.Orders
@using PhoneShop.Models
@{ ViewData["Title"] = $"Order #{Model.Id}"; }

<section class="content-header">
    <div class="container-fluid"><h1>Order #@Model.Id</h1></div>
</section>
<section class="content">
    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header"><h3 class="card-title">Order Items</h3></div>
                <div class="card-body p-0">
                    <table class="table">
                        <thead><tr><th>Product</th><th>Price</th><th>Quantity</th><th>Subtotal</th></tr></thead>
                        <tbody>
                        @foreach (var item in Model.OrderDetails)
                        {
                            <tr>
                                <td>@(item.Product?.Name ?? $"Product #{item.ProductId}")</td>
                                <td>$@item.Price.ToString("F2")</td>
                                <td>@item.Quantity</td>
                                <td>$@((item.Price * item.Quantity).ToString("F2"))</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <p><strong>Customer:</strong> @Model.CustomerName</p>
                    <p><strong>Phone:</strong> @Model.ShippingPhone</p>
                    <p><strong>Email:</strong> @Model.Email</p>
                    <p><strong>Address:</strong> @Model.ShippingAddress</p>
                    <p><strong>Total:</strong> $@Model.TotalAmount.ToString("F2")</p>
                    <p><strong>PayPal order:</strong> @Model.PayPalOrderId</p>
                    <p><strong>Capture:</strong> @Model.PayPalCaptureId</p>
                </div>
            </div>
            <div class="card">
                <div class="card-body">
                    <form asp-action="UpdateStatus" method="post">
                        <input type="hidden" name="id" value="@Model.Id">
                        <select name="status" class="form-control mb-3">
                            @foreach (var status in Enum.GetValues<OrderStatus>())
                            {
                                <option value="@((int)status)" selected="@(Model.Status == (int)status)">@status</option>
                            }
                        </select>
                        <button class="btn btn-primary" type="submit">Update Status</button>
                        <a asp-action="Index" class="btn btn-secondary">Back</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
