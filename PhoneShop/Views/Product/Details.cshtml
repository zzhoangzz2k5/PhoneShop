@model PhoneShop.Models.Product

<!-- xc-breadcrumb area start -->
<div class="xc-breadcrumb__area base-bg">
    <div class="xc-breadcrumb__bg w-img xc-breadcrumb__overlay"></div>
    <div class="container">
        <div class="row">
            <div class="col-xxl-12">
                <div class="xc-breadcrumb__content p-relative z-index-1">
                    <div class="xc-breadcrumb__list">
                        <span><a asp-controller="Home" asp-action="Index">Home</a></span>
                        <span class="dvdr"><i class="icon-arrow-right"></i></span>
                        <span>@Model.Name</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- xc-breadcrumb area end -->
<!-- product details area start -->
<section class="product__details-area pt-80 pb-80">
    <div class="container">
        <div class="row gutter-y-30">
            <div class="col-xl-6 col-lg-6">
                <div class="product__details-thumb-tab">
                    <div class="product__details-thumb-content w-img border p-4 text-center rounded bg-white">
                        <img src="~/img/products/@Model.Photo" alt="@Model.Name" style="max-height: 400px; object-fit: contain;">
                    </div>
                </div>
            </div>
            <div class="col-xl-6 col-lg-6">
                <div class="product__details-wrapper">
                    <div class="product__details-stock">
                        <span>In Stock</span>
                    </div>

                    @if (Model.Featured == true)
                    {
                        <span class="badge bg-warning text-dark mb-2">⭐ Featured Product</span>
                    }

                    <h3 class="product__details-title">@Model.Name</h3>

                    <div class="product__details-rating d-flex align-items-center">
                        <div class="product__rating product__rating-2 d-flex text-warning">
                            <span><i class="icon-star"></i></span>
                            <span><i class="icon-star"></i></span>
                            <span><i class="icon-star"></i></span>
                            <span><i class="icon-star"></i></span>
                            <span><i class="icon-star"></i></span>
                        </div>
                        <div class="product__details-rating-count">
                            <span>(12 customer reviews)</span>
                        </div>
                    </div>

                    <p>@Model.Description</p>

                    <div class="product__details-price">
                        @if (Model.PriceSale < Model.Price)
                        {
                            <span class="product__details-ammount old-ammount">$@Model.Price</span>
                            <span class="product__details-ammount new-ammount">$@Model.PriceSale</span>
                            var discount = (int)(100 - (Model.PriceSale / Model.Price * 100));
                            <span class="product__details-offer">-@discount%</span>
                        }
                        else
                        {
                            <span class="product__details-ammount new-ammount">$@Model.Price</span>
                        }
                    </div>

                    <form method="get" asp-controller="Cart" asp-action="AddToCart">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="product__details-quantity">
                            <div class="xc-product-quantity mt-10 mb-10">
                                <span class="xc-cart-minus sub">
                                    <i class="fas fa-minus"></i>
                                </span>
                                <input class="xc-cart-input" type="text" name="quantity" value="1" />
                                <span class="xc-cart-plus add">
                                    <i class="fas fa-plus"></i>
                                </span>
                            </div>
                        </div>

                        <div class="product__details-action d-flex flex-wrap align-items-center gap-2">
                            <button type="submit" class="product-add-cart-btn swiftcart-btn border-0">
                                <i class="icon-grocery-store"></i> Add to Cart
                            </button>
                        </div>
                    </form>

                    <div class="product__details-sku product__details-more mt-4">
                        <p>SKU:</p>
                        <span>PH-@Model.Id-S</span>
                    </div>
                    <div class="product__details-categories product__details-more">
                        <p>Category:</p>
                        <span>
                            <a href="#">@(Model.Category?.Name ?? "Smartphones")</a>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- product details area end -->
<!-- featured related products start -->
@{
    var featuredProducts = ViewBag.FeaturedProducts as List<PhoneShop.Models.Product>;
}
@if (featuredProducts != null && featuredProducts.Count > 0)
{
    <section class="xc-featured pb-80">
        <div class="container">
            <div class="xc-sec-heading">
                <h3 class="xc-sec-heading__title">
                    <span><i class="icon-star"></i></span>
                    Featured Products
                </h3>
            </div>

            <div class="row">
                @foreach (var product in featuredProducts)
                {
                    <div class="col-lg-3 col-md-6 mb-4">
                        <div class="card h-100 border-0 shadow-sm">
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id">
                                <img src="~/img/products/@product.Photo"
                                     class="card-img-top p-3"
                                     style="height:200px;object-fit:contain;"
                                     alt="@product.Name">
                            </a>
                            <div class="card-body text-center">
                                <span class="badge bg-warning text-dark mb-1">⭐ Featured</span>
                                <h5 class="card-title mt-1">
                                    <a asp-controller="Product"
                                       asp-action="Details"
                                       asp-route-id="@product.Id"
                                       class="text-dark text-decoration-none">
                                        @product.Name
                                    </a>
                                </h5>
                                @if (product.PriceSale < product.Price)
                                {
                                    <del class="text-muted small">$@product.Price</del>
                                    <div class="text-danger fw-bold">$@product.PriceSale</div>
                                }
                                else
                                {
                                    <div class="text-primary fw-bold">$@product.Price</div>
                                }
                            </div>
                            <div class="card-footer bg-white border-0 text-center pb-3">
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id"
                                   class="btn btn-outline-primary btn-sm">
                                    <i class="icon-eye"></i> View
                                </a>
                                <a asp-controller="Cart" asp-action="AddToCart" asp-route-id="@product.Id"
                                   class="btn btn-primary btn-sm">
                                    <i class="icon-grocery-store"></i> Add To Cart
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}
<!-- featured related products end -->
@section Scripts {
    <script>
        // Quantity input validation on product details page
        $(document).ready(function () {
            var $input = $('.product__details-quantity .xc-cart-input');

            // Ensure min 1
            $input.on('change', function () {
                var val = parseInt($(this).val());
                if (isNaN(val) || val < 1) {
                    $(this).val(1);
                }
            });
        });
    </script>
}
